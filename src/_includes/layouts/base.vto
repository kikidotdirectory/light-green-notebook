<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ title }}</title>
		{{ if css }}
			{{ css |> inlinecss }}
		{{ /if -}}
		{{ if head }}
			{{ head }}
		{{ /if }}
		<link rel="stylesheet" href="/style.css">
	</head>
	<body>
		{{ comp.nav({ url: url, title: title }) }}
		{{ content }}
	</body>
</html>
