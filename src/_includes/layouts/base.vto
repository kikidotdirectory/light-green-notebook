<!DOCTYPE html>
<html lang="en" {{ if forceMode }} data-force-mode="{{ forceMode }}"{{ /if }}>
	<head>
		<meta charset="UTF-8">
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
			viewport-fit="cover"
		>
		<title>{{ title }}</title>
		<script>
		let totalSpreads = {{ notebooks.lgn.totalSpreads }};
		</script>
		<script src="/script.js" type="module"></script>
		{{ if head }}{{ head }}{{ /if }}
		<link rel="stylesheet" href="/style.css">
	</head>
	<body>
		{{ content }}
	</body>
</html>
