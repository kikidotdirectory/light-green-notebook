<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Document</title>
		<link rel="stylesheet" href="/style.css">
	</head>
	<body>
		<div class="notebook-viewer">
			<div class="container">
				<div class="image-container">
					<img src="/assets/light-green-notebook/spread_{{ spread |> padStart }}.png" alt="">
				</div>
			</div>
			<div class="container annotations">
				{{ content }}
			</div>
		</div>
	</body>
</html>
