---
title: ◻
---

{{ layout "layouts/base.vto" }}
	<main>
		<figure
			class="notebook-viewer"
			style="--in-rem-ratio: {{ config['rem-per-inch'] }}rem; --notebook-width: {{ notebooks.lgn.dimensions.width }}; --notebook-height: {{ notebooks.lgn.dimensions.height }}"
			data-spread="0"
		>
			<div class="notebook-container">
				<img
					class="spread-image"
					{{# todo, make this not hardcoded #}}
					src="/assets/spreads/0000.png"
					data-spread="0"
					alt=""
				>
				<button
					type="button"
					class="page-link prev"
					aria-label="Previous spread"
				>
				</button>
				<button
					type="button"
					class="page-link next"
					aria-label="Next spread"
				>
				</button>
			</div>
			<figcaption class="annotations">
				{{ for [spread, group] of Object.entries(notebooks.lgn.annotations) }}
					<div
						class="annotation-group"
						data-spread="{{ spread }}"
						{{ if spread !== "0" }}
							hidden{{ /if }}
					>
						{{ for [key, annotation] of Object.entries(group) }}
							<span class="annotation" data-key="{{ key }}">
								<span class="annotation-pages">{{ annotation.label }}</span>
								<span class="annotation-title">{{ annotation.title }}</span>
							</span>
						{{ /for }}
					</div>
				{{ /for }}
			</figcaption>
		</figure>
	</main>
{{ /layout }}
