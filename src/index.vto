---
title: ◻
---

{{ layout "layouts/base.vto" }}
	{{ set head }}
		{{
			set layoutColRem = Math.round(notebooks.lgn.dimensions.width * config["rem-per-inch"] * 2 * 100)
			/ 100
		}}
		{{
			set layoutRowRem = Math.round(notebooks.lgn.dimensions.height * config["rem-per-inch"] * 100)
			/ 100
		}}
		<style>
		:root {
			--layout-col: {{ layoutColRem }}rem;
			--layout-row: {{ layoutRowRem }}rem;
			--in-rem-ratio: {{ config["rem-per-inch"] }}rem;
			--notebook-width: {{ notebooks.lgn.dimensions.width }};
			--notebook-height: {{ notebooks.lgn.dimensions.height }};
			--cover-aspect-ratio: 2064 / 2560;
			--spread-aspect-ratio: 3508 / 2550;
		}
		</style>
	{{ /set }}

	<header>
		{{ comp.tocList() }}
	</header>
	{{ comp.notebookViewer() }}
	{{ comp.subtitles() }}
	{{ comp.marks() }}
{{ /layout }}
