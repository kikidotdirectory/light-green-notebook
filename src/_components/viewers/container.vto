{{# desktop viewer: single paginated spread, flipped via .page-link buttons. hidden under [data-mode="single"] (see notebook-viewer.css) #}}
<figure
	class="notebook-viewer"
	data-spread="0"
>
	<div class="notebook-container">
		{{# hardcode cover and first page #}}
		<img
			class="cover-image"
			src="/assets/spreads/000.png"
			alt=""
		>
		<img
			class="spread-image"
			src="/assets/spreads/001.png"
			alt=""
		>
		<button
			type="button"
			class="page-link prev"
			aria-label="Previous spread"
		>
		</button>
		<button
			type="button"
			class="page-link next"
			aria-label="Next spread"
		>
		</button>
	</div>
</figure>
